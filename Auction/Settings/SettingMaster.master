                                <li><asp:LinkButton ID="xlnkbtnPurchase" runat="server" OnClick="xlnkbtnPurchase_Click">Purchase</asp:LinkButton></li>
                                <li><asp:LinkButton ID="xlnkbtnOthers" runat="server" OnClick="xlnkbtnOthers_Click">Others</asp:LinkButton></li>
                            </ul>
                        </li>
    				</ul>
        </div>
                                <div class="rightBlk">
