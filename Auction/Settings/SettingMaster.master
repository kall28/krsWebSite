            <ul class="mailCategory">
                        <li><asp:LinkButton ID="lnkbtnCompose" runat="server" OnClick="lnkbtnCompose_Click">Compose</asp:LinkButton></li>
                        <li><asp:LinkButton ID="lnkbtnInbox" runat="server" CssClass="act" OnClick="lnkbtnInbox_Click">Inbox</asp:LinkButton></li>
                        <li><asp:LinkButton ID="lnkbtnSentMail" runat="server" OnClick="lnkbtnSentMail_Click">Sent Mail</asp:LinkButton></li>
